{
  "expo": {
    "name": "TECHHUB",
    "slug": "techhub",
    "version": "1.0.0",
    "scheme": "techhub",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "site.joytree.techhub",
      "infoPlist": {
        "NSCameraUsageDescription": "TECHHUB uses the camera to scan product barcodes."
      }
    },
    "android": {
      "package": "site.joytree.techhub",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1f3a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TECHHUB to scan product barcodes."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0b1f3a",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://techhub-api.joytree.site"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1f3a"
    }
  }
}