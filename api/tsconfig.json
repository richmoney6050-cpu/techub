{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": false, "noImplicitAny": false, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true, "noEmit": true, "types": ["node"]
  },
  "include": ["src", "tests"]
}
