# Copy to .env (never commit .env). On JoyTree set these as environment variables instead.
PORT=4000
NODE_ENV=production
# Use the connection string JoyTree gives you for your PostgreSQL database
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to "true" if your database requires SSL
DATABASE_SSL=false
# Long random string, at least 32 chars:  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
SESSION_HOURS=12
# Comma-separated list of web app origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Where uploaded product photos/logos are stored (mount a persistent volume here)
UPLOAD_DIR=./uploads
# Optional: email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TECHHUB <no-reply@example.com>
